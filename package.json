{
  "name": "iphone-duo-check",
  "version": "0.1.0",
  "description": "Check a website for iPhone Duo layout problems: sideways scroll, layouts that don't update when the phone opens, controls on the fold, small tap targets",
  "license": "MIT",
  "author": "Tehseen Ullah",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TEHSEENULLAH786/iphone-duo-check.git"
  },
  "homepage": "https://github.com/TEHSEENULLAH786/iphone-duo-check#readme",
  "bugs": {
    "url": "https://github.com/TEHSEENULLAH786/iphone-duo-check/issues"
  },
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "bin": {
    "iphone-duo-check": "bin/iphone-duo-check.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "iphone-duo",
    "foldable",
    "responsive",
    "safari",
    "webkit",
    "playwright",
    "layout",
    "testing"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "playwright": "^1.64.0"
  }
}
